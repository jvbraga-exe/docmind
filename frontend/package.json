{
  "name": "docmind-python-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"..\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir .. --reload --reload-dir ../app --host 127.0.0.1 --port 8084\" \"vite --host 127.0.0.1\"",
    "dev:unix": "concurrently -k -n api,web \"../.venv/bin/python -m uvicorn app.main:app --app-dir .. --reload --reload-dir ../app --host 127.0.0.1 --port 8084\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "prettier": "^3.5.0",
    "concurrently": "^9.2.1"
  }
}
